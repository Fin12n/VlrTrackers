# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_optional_for_instant_testing

# HenrikDev API Key (https://docs.henrikdev.xyz/)
HENRIK_API_KEY=your_henrikdev_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# PostgreSQL Database URL for Drizzle ORM
# (If left empty, bot will gracefully use In-Memory RAM cache)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valorant_bot
